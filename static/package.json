    "@radix-ui/react-slot": "1.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "fuse.js": "7.5.0",
    "lucide-react": "1.25.0",
    "next": "16.2.10",
    "next-themes": "0.4.6",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "rehype-autolink-headings": "7.1.0",
    "rehype-pretty-code": "0.14.4",
    "rehype-slug": "6.0.0",
